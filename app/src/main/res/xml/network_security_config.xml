<?xml version="1.0" encoding="utf-8"?>
<!-- 
  Network Security Configuration
  Permits cleartext HTTP for self-hosted Jellyfin servers (local IP or DDNS without reverse-proxy TLS)
  while supporting system CA trust anchors.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
