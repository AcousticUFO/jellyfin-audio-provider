<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+ cloud and device-to-device backup exclusion rules -->
<data-extraction-rules>
    <cloud-backup>
        <!-- Exclude authentication tokens, cached files, and databases -->
        <exclude domain="sharedpref" path="secure_credentials.xml" />
        <exclude domain="sharedpref" path="server_config.xml" />
        <exclude domain="database" path="." />
        <exclude domain="file" path="jellyfin_tracks" />
        <exclude domain="file" path="jellyfin_thumbs" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_credentials.xml" />
        <exclude domain="file" path="jellyfin_tracks" />
        <exclude domain="file" path="jellyfin_thumbs" />
    </device-transfer>
</data-extraction-rules>
